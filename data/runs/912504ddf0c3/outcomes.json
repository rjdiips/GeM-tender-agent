   "stage": "judge",
   "triage": "maybe",
   "reason": "The tender is for a general IT project agency and a specific XDR (cybersecurity) solution for threat detection, not for financial fraud detection or transaction monitoring systems.",
   "evidence": [
    {
     "quote": "RFP - 70/2026-27 for Supply, Installation, Configuration, Integration and Maintenance of AI-powered Enterprise Extended Detection and Response (XDR) solution for a period of five (5) years",
     "file": "RFP_414eedbf-af66-4ac3-80c31794577118498_deekshika.jadyada.pdf",
     "page": 115,
     "verified": true
    },
    {
     "quote": "The Bank invites proposals from eligible bidders to supply, installation, configuration, integration, and maintenance of AI-powered enterprise extended detection and response (XDR) solution for five years, enhancing its cyber threat detection, analysis, and response capabilities across its IT infrastructure.",
     "file": "RFP_414eedbf-af66-4ac3-80c31794577118498_deekshika.jadyada.pdf",
     "page": 118,
     "verified": true
    },
    {
     "quote": "The proposed solution should detect malicious user activities including but not limited to stolen or misused credentials, lateral movement, credential harvesting, exfiltration, or brute-force attacks by applying AI/ML techniques.",
     "file": "RFP_414eedbf-af66-4ac3-80c31794577118498_deekshika.jadyada.pdf",
     "page": 159,
     "verified": true
    }
   ],
