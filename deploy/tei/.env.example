# Copy to .env (git-ignored) and adjust.
#
# Bind address. 0.0.0.0 serves the LAN and every docker bridge; set this host's LAN
# address to expose only that interface, e.g. TEI_HOST=10.0.10.11.
TEI_HOST=0.0.0.0

# Small models: fast enough for the 3-10 s per bid budget on the CPU.
# Swap for the full-size pair if quality matters more than latency:
#   EMBED_MODEL_ID=BAAI/bge-m3          (568M, 1024 dims, ~2.5 pages/s on CPU)
#   RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3   (568M, ~9 s per 24 passages on CPU)
EMBED_MODEL_ID=BAAI/bge-small-en-v1.5
RERANK_MODEL_ID=BAAI/bge-reranker-base
