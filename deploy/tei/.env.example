# Copy to .env (git-ignored) and adjust.
#
# Bind address. 0.0.0.0 serves the LAN and every docker bridge; set this host's LAN
# address to expose only that interface, e.g. TEI_HOST=10.0.10.11.
TEI_HOST=0.0.0.0

# The embedder: MiniLM is the default and the same model the app
# would load locally, so local and remote agree. bge-small ties it at hit@8 and loses at
# hit@24; bge-m3 is ~10x slower on the CPU.
EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# The GPU variant is a manual choice (compose profile `gpu`), not an automatic one:
#   docker compose stop embed && docker compose --profile gpu up -d embed-gpu
