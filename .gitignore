# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.deepeval/

# --- Secrets / local config ---
.env
.env.*
!.env.example

# --- Node / web (web/ also has its own .gitignore) ---
node_modules/
web/dist/

# --- Runtime data (indexes, caches, checkpoints, logs: ~GBs) ---
data/*
!data/.gitkeep
# Run history is tracked so another app host can read the conversations and results;
# caches, the checkpoint db and lock files stay out.
!data/runs/
!data/runs/**
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.lock
*.tmp

# # Per-user / generated knowledge
# knowledge/users/*
# !knowledge/users/.gitkeep
# knowledge/topics/*
# !knowledge/topics/.gitkeep

# --- Docs (kept local, not in git) ---
# docs/

# --- Agent / tooling artifacts ---
.playwright-mcp/
graphify-out/
.claude/
.superpowers/
# AGENTS.md
.agents/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Live-search run output (raw listings, bid texts, labels, stats; regenerate with the scripts)
eval/live_search/results/
# Retrieval A/B output (vectors, logs, per-case rows; regenerate with eval/retrieval_ab/run_ab.sh)
eval/retrieval_ab/cache/
eval/retrieval_ab/logs/
eval/retrieval_ab/*.jsonl
