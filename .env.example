# Model: only the already-loaded model is ever named (spec 3.5)
LLM_BASE_URL=http://10.0.10.11:1234/v1
LLM_MODEL=qwen/qwen3.6-35b-a3b
LLM_API_KEY=not-needed

# GeM access (spec 3.2, R9)
GEM_BASE_URL=https://bidplus.gem.gov.in
RATE_LIMIT_FLOOR_S=1.0
RATE_LIMIT_ERROR_S=4.0
RATE_LIMIT_RECOVER_MIN=10
DAILY_REQUEST_BUDGET=20000

# Paths
DATA_DIR=./data
SKILLS_DIR=./skills
KNOWLEDGE_DIR=./knowledge

# Page ranking (spec 3.5.1): without EMBED_BASE_URL the Judge embeds pages locally with
# all-MiniLM-L6-v2, the measured default. EMBED_MODEL is the id a remote embedder serves.
JUDGE_CPU_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Remote models: set a URL to run embeddings/reranking on another machine.
# The embed base includes the API version, e.g. http://10.0.10.11:8080/v1 (OpenAI-compatible).
# The rerank endpoint is <base>/rerank; RERANK_STYLE=tei posts {query, texts},
# cohere posts {model, query, documents, top_n}. Leave RERANK_BASE_URL empty: reranking
# lost top-8 recall in the 20 Nov A/B for +4 s a bid (spec 3.5.1).
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_TIMEOUT_S=30
EMBED_BATCH_SIZE=64
RERANK_BASE_URL=
RERANK_STYLE=tei
RERANK_API_KEY=
RERANK_TIMEOUT_S=30

# Windows: full path to tesseract.exe when it is not on PATH
TESSERACT_CMD=

# Retention in days (spec 11.1)
RETAIN_QUARANTINE_DAYS=30
RETAIN_KEPT_AFTER_CLOSE_DAYS=180
RETAIN_ZIP_DAYS=7
RETAIN_VERDICT_AFTER_CLOSE_DAYS=30
RETAIN_RUN_LOG_DAYS=90
RETAIN_CLOSED_INDEX_ROW_DAYS=365

# Web chat
APP_HOST=0.0.0.0
APP_PORT=8700
